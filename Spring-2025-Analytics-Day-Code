def box_m_test(data, group_col):
    # Get group labels and dependent variable names
    groups = data[group_col].unique()
    dependent_vars = data.drop(columns=[group_col]).columns

    n_groups = len(groups)
    n_vars = len(dependent_vars)

    # Calculate pooled covariance matrix and individual group matrices
    cov_matrices = []
    group_sizes = []
    pooled_cov = np.zeros((n_vars, n_vars))

    for g in groups:
        group_data = data[data[group_col] == g][dependent_vars]
        cov_g = np.cov(group_data.T, bias=False)
        n_g = len(group_data)
        group_sizes.append(n_g)
        cov_matrices.append(cov_g)
        pooled_cov += (n_g - 1) * cov_g

    pooled_cov /= (sum(group_sizes) - n_groups)

    # Compute Box's M statistic
    M = 0
    for i in range(n_groups):
        n_i = group_sizes[i]
        cov_i = cov_matrices[i]
        M += (n_i - 1) * (np.log(np.linalg.det(pooled_cov)) - np.log(np.linalg.det(cov_i)))

    # Apply correction factor
    c = ((2 * n_vars**2 + 3 * n_vars - 1) / (6 * (sum(group_sizes) - n_groups))) * \
        (sum([1 / (n_i - 1) for n_i in group_sizes]) - (1 / (sum(group_sizes) - n_groups)))
    X2 = M * (1 - c)
    df = (n_groups - 1) * (n_vars * (n_vars + 1)) / 2
    p_value = 1 - chi2.cdf(X2, df)

    return {
        "Box's M": M,
        "Chi-square (adjusted)": X2,
        "df": df,
        "p-value": p_value
    }

